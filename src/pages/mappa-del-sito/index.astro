---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { serviceLinks, team } from '../../data/site';
import { projects } from '../../data/projects';
const title = 'Mappa del sito | Studio Tecnico A’RS';
const description = 'Mappa del sito dello Studio Tecnico A’RS di Mestre-Venezia: pagine, servizi, progetti, team e informazioni legali.';
---
<BaseLayout title={title} description={description}>
  <section class="pt-[calc(var(--header-h)+3rem)] pb-16 md:pb-24">
    <div class="container-site">
      <nav aria-label="Percorso di navigazione" class="text-xs">
        <ol class="flex flex-wrap items-center gap-2 text-grey">
          <li class="flex items-center gap-2">
            <a href="/" class="link-underline hover:text-accent transition-colors"> Home </a>
          </li>
          <li class="flex items-center gap-2">
            <span aria-hidden="true">/</span>
            <span aria-current="page" class="text-ink"> Mappa del sito </span>
          </li>
        </ol>
      </nav>
      <h1 class="mt-5 font-heading text-h1 text-ink">Mappa del sito</h1>
      <p class="mt-5 max-w-2xl text-body">Tutte le pagine del sito dello Studio Tecnico A’RS: lo studio, i servizi, i progetti, il team e i contatti.</p>
      <div class="mt-12 grid md:grid-cols-2 lg:grid-cols-4 gap-10">
        <div>
          <h2 class="font-heading text-h4 text-ink pb-2 border-b border-ink/10">Pagine</h2>
          <ul class="mt-4 space-y-2 text-s">
            <li>
              <a href="/" class="link-underline">Home</a>
            </li>
            <li>
              <a href="/studio/" class="link-underline">Lo studio</a>
            </li>
            <li>
              <a href="/servizi/" class="link-underline">Servizi</a>
            </li>
            <li>
              <a href="/portfolio/" class="link-underline">Progetti</a>
            </li>
            <li>
              <a href="/contatti/" class="link-underline">Contatti</a>
            </li>
          </ul>
        </div>
        <div>
          <h2 class="font-heading text-h4 text-ink pb-2 border-b border-ink/10">Servizi</h2>
          <ul class="mt-4 space-y-2 text-s">
            {serviceLinks.map((s) => (<li> <a href={s.href} class="link-underline"> {s.label} </a> </li>))}
          </ul>
        </div>
        <div>
          <h2 class="font-heading text-h4 text-ink pb-2 border-b border-ink/10">Team</h2>
          <ul class="mt-4 space-y-2 text-s">
            {team.map((p) => (<li> <a href={p.href} class="link-underline"> {p.name} </a> </li>))}
          </ul>
        </div>
        <div>
          <h2 class="font-heading text-h4 text-ink pb-2 border-b border-ink/10">Progetti</h2>
          <ul class="mt-4 space-y-2 text-s">
            {projects.map((p) => (<li> <a href={`/portfolio/${p.slug}/`} class="link-underline"> {p.title} </a> </li>))}
          </ul>
          <h2 class="font-heading text-h4 text-ink pb-2 border-b border-ink/10 mt-10">Legali</h2>
          <ul class="mt-4 space-y-2 text-s">
            <li>
              <a href="/privacy-policy/" class="link-underline">Privacy Policy</a>
            </li>
            <li>
              <a href="/cookie-policy/" class="link-underline">Cookie Policy</a>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
