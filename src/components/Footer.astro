---
import { site, nav, serviceLinks, socials, team } from '../data/site';
const mapsQuery = (addr: string) => `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.name + ', ' + addr)}`;
const year = new Date().getFullYear();
---
<footer id="site-footer" class="relative overflow-hidden bg-ink text-white/85">
  <!-- CTA -->
  <section class="relative z-10 container-site pt-20 pb-14 md:pt-28 md:pb-20">
    <div class="grid md:grid-cols-12 gap-8 items-end reveal-in">
      <div class="md:col-span-8">
        <p class="eyebrow mb-3">Iniziamo</p>
        <h2 class="font-heading text-h1 leading-[1.02] max-w-3xl text-white">
          Contattaci per ricevere un preventivo
        </h2>
        <p class="mt-m max-w-xl text-white/70">
          È sufficiente compilare il form e specificare la richiesta per ottenere in breve tempo un preventivo di spesa.
        </p>
      </div>
      <div class="md:col-span-4 flex flex-wrap gap-3 md:justify-end">
        <a href="/contatti/#richiedi" class="btn-primary">Richiedi un preventivo</a>
        {site.whatsapp
          ? <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener" class="btn-outline-light">WhatsApp</a>
          : <a href={`tel:${site.phones[0].href}`} class="btn-outline-light">Chiama lo studio</a>}
      </div>
    </div>
  </section>

  <!-- Nav columns -->
  <section class="relative z-10 container-site py-14 md:py-16 reveal-in">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12">
      <div class="flex flex-col gap-3">
        <h3 class="text-xs uppercase tracking-[.22em] text-white/45 mb-1 font-semibold">Studio</h3>
        {site.addresses.map((a) => (
          <a href={mapsQuery(a.text)} target="_blank" rel="noopener" class="text-sm text-white/75 hover:text-white transition-colors self-start">
            <span class="block text-white/45 text-xs uppercase tracking-wider">{a.label}</span>
            {a.text}
          </a>
        ))}
        <a href={`mailto:${site.email}`} class="text-sm text-white/75 hover:text-white transition-colors self-start">{site.email}</a>
        {site.phones.map((p) => (
          <a href={`tel:${p.href}`} class="text-sm text-white/75 hover:text-white transition-colors self-start">
            <span class="block text-white/45 text-xs uppercase tracking-wider">{p.role}</span>
            {p.label}
          </a>
        ))}
      </div>

      <div class="flex flex-col gap-3">
        <h3 class="text-xs uppercase tracking-[.22em] text-white/45 mb-1 font-semibold">Naviga</h3>
        <a href="/" class="text-sm text-white/75 hover:text-white transition-colors self-start">Home</a>
        {nav.map((item) => (
          <a href={item.href} class="text-sm text-white/75 hover:text-white transition-colors self-start">{item.label}</a>
        ))}
        <a href="/mappa-del-sito/" class="text-sm text-white/75 hover:text-white transition-colors self-start">Mappa del sito</a>
      </div>

      <div class="flex flex-col gap-3">
        <h3 class="text-xs uppercase tracking-[.22em] text-white/45 mb-1 font-semibold">Servizi</h3>
        {serviceLinks.map((s) => (
          <a href={s.href} class="text-sm text-white/75 hover:text-white transition-colors self-start">{s.label}</a>
        ))}
      </div>

      <div class="flex flex-col gap-3">
        <h3 class="text-xs uppercase tracking-[.22em] text-white/45 mb-1 font-semibold">Team</h3>
        {team.map((p) => (
          <a href={p.href} class="text-sm text-white/75 hover:text-white transition-colors self-start">{p.name}</a>
        ))}
        <a href="/studio/#team" class="text-sm text-accent hover:text-white transition-colors self-start">Conosci il team →</a>
      </div>
    </div>

    {socials.length > 0 && (
      <div class="mt-12 flex flex-wrap gap-x-6 gap-y-2">
        <span class="text-xs uppercase tracking-[.22em] text-white/45">Seguici</span>
        {socials.map((s) => (
          <a href={s.href} target="_blank" rel="noopener" class="text-sm text-white/70 hover:text-accent transition-colors">{s.label}</a>
        ))}
      </div>
    )}
  </section>

  <!-- Logo + bottom -->
  <section class="relative z-10 container-site pb-12 md:pb-16">
    <div class="reveal-in">
      <a href="/" aria-label={`${site.name} — home`} class="inline-block">
        <img src="/images/brand/logo-footer.svg" width="360" height="224" alt={site.name} loading="lazy" decoding="async" class="w-[110px] md:w-[150px] h-auto" />
      </a>
      <p class="mt-6 text-sm md:text-base text-white/80">
        Studio tecnico di geometri a Mestre-Venezia, dal 2003 · {site.tagline}
      </p>
    </div>
    <div class="mt-12 flex flex-col md:flex-row md:items-center md:justify-between gap-4 text-xs text-white/50">
      <p>© {year} {site.name} · {site.legalName} · P.IVA {site.legal.vat}</p>
      <div class="flex flex-wrap items-center gap-6">
        <a href="/privacy-policy/" class="hover:text-white transition-colors">Privacy</a>
        <a href="/cookie-policy/" class="hover:text-white transition-colors">Cookie</a>
        <a href={`mailto:${site.email}`} class="hover:text-white transition-colors">{site.email}</a>
      </div>
    </div>
  </section>
</footer>
