---
import type { GalleryImage } from '../data/projects';
interface Props { img: GalleryImage; slug: string; delay: number; variant?: 'main' | 'before'; }
const { img, delay } = Astro.props;
const cls = `group reveal-in overflow-hidden bg-grey-light aspect-[${img.aspect}]${img.dimmed ? ' opacity-95' : ''}`;
---
<figure class={cls} style={`transition-delay:${delay}ms`}>
  <img
    src={img.src} width={img.w} height={img.h}
    alt={img.alt} loading="lazy" decoding="async"
    class="w-full h-full object-cover transition-transform duration-[900ms] ease-out group-hover:scale-[1.06]"
  />
</figure>
