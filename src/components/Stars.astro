---
interface Props { size?: number; label?: string; class?: string; value?: number; }
const { size = 14, label = '5 stelle su 5', class: cls = '', value = 5 } = Astro.props;
---
<span class={`inline-flex items-center gap-[3px] text-accent ${cls}`} role="img" aria-label={label}>
  {Array.from({ length: 5 }).map((_, i) => (
    <svg class={i < Math.round(value) ? '' : 'opacity-30'} width={size} height={size} viewBox="0 0 20 20" fill="currentColor" stroke="currentColor" stroke-width="0" aria-hidden="true" focusable="false">
      <path d="M10 1.6l2.47 5.3 5.53.72-4.06 3.9 1.03 5.68L10 14.5l-4.97 2.7 1.03-5.68L2 7.62l5.53-.72L10 1.6z"></path>
    </svg>
  ))}
</span>
