---
import Stars from './Stars.astro';
import { reviews, reviewsSummary } from '../data/reviews';
---
<section id="recensioni" class="relative overflow-hidden bg-ink text-white py-16 md:py-20">
  <div class="reviews-glow" aria-hidden="true"></div>
  <div class="container-site relative z-10">
    <!-- Fascia di sintesi a tutta larghezza -->
    <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-6 reveal-in">
      <div>
        <p class="eyebrow mb-3">Dicono di noi</p>
        <h2 class="font-heading text-h2 text-white leading-tight max-w-2xl">{reviewsSummary.heading}</h2>
      </div>
      <div class="flex items-end gap-5">
        <span class="font-heading text-[3.5rem] md:text-[4rem] leading-[.8] font-semibold text-white">{reviewsSummary.rating}</span>
        <div class="pb-1">
          <Stars size={18} value={reviewsSummary.ratingValue} label={`${reviewsSummary.rating} stelle su 5`} />
          <p class="mt-2 text-s text-white/60">su {reviewsSummary.count} {reviewsSummary.count === 1 ? 'recensione' : 'recensioni'} Google</p>
        </div>
        <a href={reviewsSummary.googleReviewsUrl} target="_blank" rel="noopener" class="btn-outline-light !px-5 !py-2.5 ml-2 self-end">Leggi tutte su Google</a>
      </div>
    </div>

    <!-- Griglia piena -->
    <ul class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {reviews.map((r, i) => (
        <li class="review-card group relative flex flex-col bg-white/[0.045] border border-white/10 p-6 transition-colors duration-300 hover:bg-white/[0.08] hover:border-white/20 reveal-in" style={`transition-delay:${i * 60}ms`}>
          <span class="absolute right-5 top-2 font-heading text-[3.25rem] leading-none text-accent/25 select-none" aria-hidden="true">&rdquo;</span>
          <Stars size={14} class="mb-3" />
          <blockquote class="review-text text-s text-white/80 flex-1"><p>{r.text}</p></blockquote>
          <button type="button" class="review-more mt-3 self-start text-xs uppercase tracking-[.14em] text-accent hover:text-white transition-colors" hidden>Leggi tutto</button>
          <figcaption class="mt-4 pt-4 border-t border-white/10 flex items-center gap-3">
            <span class="grid place-items-center w-8 h-8 rounded-full bg-accent/20 text-accent font-heading font-semibold text-xs shrink-0" aria-hidden="true">{r.initial}</span>
            <span class="min-w-0">
              <span class="block text-sm text-white truncate">{r.name}</span>
              <span class="block text-xs text-white/45">{r.date}{r.translated && (<span class="italic"> · Tradotto da Google</span>)}</span>
            </span>
            <svg class="ml-auto shrink-0 opacity-70" width="15" height="15" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
              <path fill="#4285F4" d="M45.1 24.5c0-1.6-.1-3.2-.4-4.7H24v8.9h11.8c-.5 2.8-2 5.1-4.4 6.7v5.6h7.1c4.2-3.8 6.6-9.5 6.6-16.5z"></path>
              <path fill="#34A853" d="M24 46c5.9 0 10.9-2 14.5-5.3l-7.1-5.6c-2 1.3-4.5 2.1-7.4 2.1-5.7 0-10.5-3.8-12.2-9H4.5v5.8C8.1 41.3 15.5 46 24 46z"></path>
              <path fill="#FBBC05" d="M11.8 28.2c-.4-1.3-.7-2.7-.7-4.2s.2-2.9.7-4.2v-5.8H4.5C2.9 17.1 2 20.4 2 24s.9 6.9 2.5 10l7.3-5.8z"></path>
              <path fill="#EA4335" d="M24 10.5c3.2 0 6.1 1.1 8.4 3.3l6.3-6.3C34.9 4 29.9 2 24 2 15.5 2 8.1 6.7 4.5 13.8l7.3 5.8c1.7-5.2 6.5-9.1 12.2-9.1z"></path>
            </svg>
          </figcaption>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .reviews-glow { position: absolute; top: -30%; right: -10%; width: 55vw; height: 55vw; max-width: 700px; max-height: 700px; background: radial-gradient(circle, #71916833, #71916800 65%); /* verde logo (accent.light) */ pointer-events: none; }
  .review-text { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 7; overflow: hidden; }
  .review-card.is-open .review-text { display: block; overflow: visible; }
</style>

<script>
  document.querySelectorAll(".review-card").forEach(t=>{const i=t.querySelector(".review-text"),e=t.querySelector(".review-more");if(!i||!e)return;if(i.scrollHeight-i.clientHeight>4){e.hidden=!1;e.addEventListener("click",()=>{const o=t.classList.toggle("is-open");e.textContent=o?"Riduci":"Leggi tutto"})}});
</script>
